[{"t0": 0.32, "t1": 1.7, "text": "Sigue escondiéndole tus planes a"}, {"t0": 1.7, "t1": 2.24, "text": "todo el mundo"}, {"t0": 2.84, "t1": 3.56, "text": "Y por eso tu vida"}, {"t0": 3.56, "t1": 5.04, "text": "sigue siendo una completa basura"}, {"t0": 5.32, "t1": 6.32, "text": "Crees que exponer lo que"}, {"t0": 6.32, "t1": 7.34, "text": "vas a hacerte motiva"}, {"t0": 7.56, "t1": 8.34, "text": "pero tu mente es tan"}, {"t0": 8.34, "t1": 9.6, "text": "débil que confunde la aprobación"}, {"t0": 9.6, "t1": 10.98, "text": "barata con el esfuerzo real"}, {"t0": 11.12, "t1": 12.32, "text": "Te sientes satisfecho hablando de"}, {"t0": 12.32, "t1": 13.34, "text": "un imperio que ni siquiera"}, {"t0": 13.34, "t1": 14.64, "text": "has empezado a construir"}, {"t0": 14.84, "t1": 15.9, "text": "Mientras abres la boca para"}, {"t0": 15.9, "t1": 17.12, "text": "mendigar simpatía"}, {"t0": 17.24, "t1": 18.84, "text": "los verdaderos ganadores destruyen sus"}, {"t0": 18.84, "t1": 20.08, "text": "límites en silencio"}, {"t0": 20.32, "t1": 21.08, "text": "¿La cruda verdad?"}, {"t0": 21.4, "t1": 22.54, "text": "¿Te da terror pagar el"}, {"t0": 22.54, "t1": 23.16, "text": "precio?"}, {"t0": 23.3, "t1": 24.8, "text": "¿Te aterroriza desaparecer 3"}, {"t0": 25.02, "t1": 26.1, "text": "4 o 6 meses"}, {"t0": 26.22, "t1": 27.18, "text": "apagar el teléfono"}, {"t0": 27.32, "t1": 29.06, "text": "cerrar las aplicaciones y romperse"}, {"t0": 29.06, "t1": 30.36, "text": "el alma en solitario mientras"}, {"t0": 30.36, "t1": 32.26, "text": "el resto festeja la mediocridad"}, {"t0": 32.42, "t1": 33.5, "text": "Pretendiste que no te importaba"}, {"t0": 33.5, "t1": 34.04, "text": "la masa"}, {"t0": 34.1, "t1": 35.08, "text": "te pusiste la máscara de"}, {"t0": 35.08, "t1": 36.1, "text": "indiferencia"}, {"t0": 36.36, "t1": 37.32, "text": "Pero la primera mirada de"}, {"t0": 37.32, "t1": 38.58, "text": "juicio te paralizó y te"}, {"t0": 38.58, "t1": 39.88, "text": "devolvió a tu rincón"}, {"t0": 39.96, "t1": 41.38, "text": "Vivimos ahogados en ruido"}, {"t0": 41.56, "t1": 42.8, "text": "aplaudiendo el éxito a Geno"}, {"t0": 42.8, "t1": 44.12, "text": "mientras tú sigues regalando tu"}, {"t0": 44.12, "t1": 45.44, "text": "atención a la basura"}, {"t0": 45.56, "t1": 46.44, "text": "Todo el mundo quiere la"}, {"t0": 46.44, "t1": 46.84, "text": "cima"}, {"t0": 46.98, "t1": 48.04, "text": "pero nadie tiene el carácter"}, {"t0": 48.04, "t1": 49.14, "text": "para encerrarse en la oscuridad"}, {"t0": 49.14, "t1": 50.64, "text": "a sangrar por sus metas"}, {"t0": 50.74, "t1": 51.96, "text": "Un hombre es recompensado en"}, {"t0": 51.96, "t1": 53.58, "text": "público únicamente por el terror"}, {"t0": 53.66, "t1": 54.86, "text": "la disciplina y el esfuerzo"}, {"t0": 54.86, "t1": 56.12, "text": "que soportó en privado"}, {"t0": 56.2, "t1": 57.64, "text": "¿Puedes desconectar un solo momento"}, {"t0": 57.64, "t1": 58.44, "text": "y dejar de huir de"}, {"t0": 58.44, "t1": 59, "text": "ti mismo?"}, {"t0": 59.12, "t1": 59.86, "text": "La razón por la que"}, {"t0": 59.86, "t1": 61.48, "text": "sigues frustrado y estancado es"}, {"t0": 61.48, "t1": 62.6, "text": "porque no has tenido el"}, {"t0": 62.6, "t1": 63.62, "text": "valor de abandonar todo lo"}, {"t0": 63.62, "t1": 64.92, "text": "que te distrae y ejecutar"}, {"t0": 64.94, "t1": 65.98, "text": "a puerta cerrada"}, {"t0": 66.18, "t1": 67.3, "text": "Vas a tener que sacrificar"}, {"t0": 67.3, "t1": 68.32, "text": "tu comodidad"}, {"t0": 68.46, "t1": 69.7, "text": "soportar que nadie crea en"}, {"t0": 69.7, "t1": 70.5, "text": "ti y aceptar que no"}, {"t0": 70.5, "t1": 71.3, "text": "habrá testigos"}, {"t0": 71.58, "t1": 72.2, "text": "Solo tú"}, {"t0": 72.22, "t1": 73.6, "text": "tu reflejo y la violencia"}, {"t0": 73.6, "t1": 74.48, "text": "de la ejecución diaria"}]